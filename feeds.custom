# Fork-specific feeds for zhou1407/lede-H69k.
#
# feeds.conf.default is kept identical to coolsnowwolf/lede, so upstream can
# always be merged without conflicts (GitHub "Sync fork" works again). Fork
# feed customizations live in this file instead:
#   ./scripts/gen-feeds.sh                 # regenerate feeds.conf
#   git add -f feeds.conf && git commit    # commit it (file is gitignored)
# feeds.conf is committed on purpose: scripts/feeds prefers it over
# feeds.conf.default, so OpenWrt-CI builds the fork's feed set without any
# change to .github/workflows/openwrt-ci.yml.
#
# qmodem is commented out in upstream feeds.conf.default; re-adding it here
# keeps it enabled (no duplicate-name clash because the upstream line is
# commented out).
src-git qmodem https://github.com/FUjr/modem_feeds.git

# Passwall feeds (not present upstream).
src-git passwall_packages https://github.com/Openwrt-Passwall/openwrt-passwall-packages.git
src-git passwall_luci https://github.com/Openwrt-Passwall/openwrt-passwall.git

# helloworld is disabled by scripts/gen-feeds.sh to match this fork's original
# build set. Uncomment the line below to re-enable it.
#src-git helloworld https://github.com/fw876/helloworld.git
